{
  "plugins": [
    {
      "id": "hengxin666.todo",
      "name": "点子待办",
      "summary": "在群里随手丢想法, Agent 整理成待办, 并对值得做的点子写可行性分析; 可关联 GitHub issue, issue 关闭时待办自动完成。",
      "version": "2.1.2",
      "icon": "list-checks",
      "tags": [
        "待办",
        "点子",
        "Agent"
      ],
      "author": "HengXin666",
      "manifest": {
        "id": "hengxin666.todo",
        "name": "点子待办",
        "summary": "在群里随手丢想法, Agent 整理成待办, 并对值得做的点子写可行性分析; 可关联 GitHub issue, issue 关闭时待办自动完成。",
        "version": "2.1.2",
        "api": "2",
        "server": true,
        "engines": {
          "aioa": "^2"
        },
        "optional": {
          "service:gh.issues": "^1"
        },
        "icon": "list-checks",
        "tags": [
          "待办",
          "点子",
          "Agent"
        ],
        "author": "HengXin666",
        "readme": "README.md",
        "prompt": "prompt.md",
        "group": {
          "title": "点子待办"
        },
        "agent": {
          "name": "整理员",
          "schedule": "长连等新消息 (hxaioa watch), 每 30 分钟兜底一次, 外加主人说 \"整理一下\" 时立即跑一次",
          "interval": 1800,
          "task": "按专属指令里的插件任务整理这个群的新消息。"
        },
        "permissions": [
          "data:own"
        ],
        "contributes": {
          "collections": [
            {
              "id": "items",
              "fields": {
                "channel": "string",
                "title": "string",
                "note": "string",
                "state": "string",
                "prio": "number",
                "src": "number",
                "created": "number",
                "repo": "string",
                "issue": "number",
                "parent": "string",
                "gh": "object",
                "doneAt": "number"
              }
            }
          ]
        },
        "budget": {
          "agentPoll": 0
        },
        "space": {
          "id": "todo",
          "title": "点子待办",
          "icon": "list-checks",
          "panels": [
            {
              "id": "todos",
              "title": "待办",
              "icon": "list-checks",
              "size": "l",
              "refresh": {
                "mode": "push"
              },
              "items": [
                {
                  "id": "todo-list",
                  "type": "todo",
                  "bind": [
                    {
                      "subject": "{{channel}}",
                      "field": "todos"
                    }
                  ],
                  "props": {
                    "limit": 30
                  }
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "hengxin666.gh",
      "name": "GitHub 授权",
      "summary": "授权一次 GitHub, 令牌只存在服务端; 别的插件和你允许的 Agent 通过服务端操作 issue。",
      "version": "2.0.2",
      "icon": "github",
      "tags": [
        "GitHub",
        "授权",
        "基础"
      ],
      "author": "HengXin666",
      "manifest": {
        "id": "hengxin666.gh",
        "name": "GitHub 授权",
        "summary": "授权一次 GitHub, 令牌只存在服务端; 别的插件和你允许的 Agent 通过服务端操作 issue。",
        "version": "2.0.2",
        "icon": "github",
        "tags": [
          "GitHub",
          "授权",
          "基础"
        ],
        "author": "HengXin666",
        "readme": "README.md",
        "prompt": "prompt.md",
        "group": {
          "title": "GitHub 授权"
        },
        "api": "2",
        "server": true,
        "engines": {
          "aioa": "^2"
        },
        "provides": {
          "service:gh.issues": "1.0.0"
        },
        "permissions": [
          "net:api.github.com"
        ],
        "budget": {
          "requestsPerDay": 100
        }
      }
    },
    {
      "id": "hengxin666.github",
      "name": "GitHub 接入",
      "summary": "关注仓库的 PR, Issue, CI 与本人动态: webhook 实时入库, 有 GITHUB_TOKEN 时每 30 分钟回填; 云 Agent 也能用 events:read 的 key 读。",
      "version": "1.0.1",
      "icon": "github",
      "tags": [
        "GitHub",
        "开发"
      ],
      "author": "HengXin666",
      "manifest": {
        "id": "hengxin666.github",
        "name": "GitHub 接入",
        "summary": "关注仓库的 PR, Issue, CI 与本人动态: webhook 实时入库, 有 GITHUB_TOKEN 时每 30 分钟回填; 云 Agent 也能用 events:read 的 key 读。",
        "version": "1.0.1",
        "icon": "github",
        "tags": [
          "GitHub",
          "开发"
        ],
        "author": "HengXin666",
        "readme": "README.md",
        "prompt": "prompt.md",
        "group": {
          "title": "GitHub"
        },
        "api": "2",
        "server": true,
        "engines": {
          "aioa": "^2"
        },
        "permissions": [
          "net:api.github.com"
        ],
        "contributes": {
          "widgets": [
            {
              "id": "hengxin666.github.card",
              "title": "GitHub 卡"
            },
            {
              "id": "hengxin666.github.daily",
              "title": "每日柱状图"
            },
            {
              "id": "hengxin666.github.branches",
              "title": "未合入分支"
            }
          ],
          "commands": [
            {
              "id": "hengxin666.github.sync",
              "title": "立即同步"
            }
          ]
        },
        "budget": {
          "cron": "*/30 * * * *",
          "requestsPerDay": 200
        }
      }
    },
    {
      "id": "hengxin666.hxoa",
      "name": "hxoa 管理",
      "summary": "在手机上管理一台或多台 hxoa (需 2.4.1+): 工作区增删改, 选目录与新建文件夹, 连接令牌, 一键复制连接提示。管理令牌只存在服务端。",
      "version": "2.0.0",
      "icon": "terminal",
      "tags": [
        "hxoa",
        "服务器",
        "开发"
      ],
      "author": "HengXin666",
      "manifest": {
        "id": "hengxin666.hxoa",
        "name": "hxoa 管理",
        "summary": "在手机上管理一台或多台 hxoa (需 2.4.1+): 工作区增删改, 选目录与新建文件夹, 连接令牌, 一键复制连接提示。管理令牌只存在服务端。",
        "version": "2.0.0",
        "icon": "terminal",
        "tags": [
          "hxoa",
          "服务器",
          "开发"
        ],
        "author": "HengXin666",
        "readme": "README.md",
        "prompt": "prompt.md",
        "group": {
          "title": "hxoa"
        },
        "api": "2",
        "server": true,
        "engines": {
          "aioa": "^2"
        },
        "permissions": [
          "net:*"
        ],
        "contributes": {
          "widgets": [
            {
              "id": "hengxin666.hxoa.panel",
              "title": "hxoa 管理"
            }
          ]
        },
        "budget": {
          "requestsPerDay": 500
        }
      }
    }
  ]
}
