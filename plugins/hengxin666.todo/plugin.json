{
  "id": "hengxin666.todo",
  "name": "点子待办",
  "summary": "在群里随手丢想法, Agent 整理成待办, 并对值得做的点子写可行性分析; 可关联 GitHub issue, issue 关闭时待办自动完成。",
  "version": "2.2.0",
  "api": "2",
  "server": true,
  "engines": {
    "aioa": "^2"
  },
  "optional": {
    "service:gh.issues": "^1"
  },
  "icon": "list-checks",
  "tags": [
    "待办",
    "点子",
    "Agent"
  ],
  "author": "HengXin666",
  "readme": "README.md",
  "prompt": "prompt.md",
  "group": {
    "title": "点子待办"
  },
  "agent": {
    "name": "整理员",
    "schedule": "长连等新消息 (hxaioa watch), 每 30 分钟兜底一次, 外加主人说 \"整理一下\" 时立即跑一次",
    "interval": 1800,
    "task": "按专属指令里的插件任务整理这个群的新消息。"
  },
  "permissions": [
    "data:own"
  ],
  "contributes": {
    "collections": [
      {
        "id": "items",
        "fields": {
          "channel": "string",
          "title": "string",
          "note": "string",
          "state": "string",
          "prio": "number",
          "src": "number",
          "created": "number",
          "repo": "string",
          "issue": "number",
          "parent": "string",
          "gh": "object",
          "doneAt": "number",
          "area": "string",
          "due": "number",
          "remind": "number",
          "alarm": "boolean",
          "star": "boolean",
          "every": "object",
          "runs": "number",
          "lastDone": "number",
          "prevDue": "number"
        }
      }
    ]
  },
  "budget": {
    "agentPoll": 0
  },
  "space": {
    "id": "todo",
    "title": "点子待办",
    "icon": "list-checks",
    "panels": [
      {
        "id": "todos",
        "title": "待办",
        "icon": "list-checks",
        "size": "l",
        "refresh": {
          "mode": "push"
        },
        "items": [
          {
            "id": "todo-list",
            "type": "todo",
            "bind": [
              {
                "subject": "{{channel}}",
                "field": "todos"
              }
            ],
            "props": {
              "limit": 30
            }
          }
        ]
      }
    ]
  }
}
