{
  "id": "todo",
  "name": "点子待办",
  "summary": "在群里随手丢想法, Agent 定时整理成待办, 并对值得做的点子写可行性分析。",
  "version": "1.3.0",
  "icon": "list-checks",
  "tags": ["待办", "点子", "Agent"],
  "author": "HengXin666",
  "readme": "README.md",
  "prompt": "prompt.md",
  "group": { "title": "点子待办" },
  "agent": {
    "name": "整理员",
    "schedule": "每 30 分钟一次, 外加主人说 \"整理一下\" 时立即跑一次",
    "interval": 1800,
    "task": "整理这个群里我的新消息: 每条都引用回复, 要做的事建成待办, 没想清楚的点子回三行以内的分析, 回复后再听 5 分钟。详细规则见专属指令里的插件任务。"
  },
  "space": {
    "id": "todo",
    "title": "点子待办",
    "icon": "list-checks",
    "panels": [
      {
        "id": "todos",
        "title": "待办",
        "icon": "list-checks",
        "size": "l",
        "refresh": { "mode": "push" },
        "items": [
          { "id": "todo-list", "type": "todo", "bind": [{ "subject": "{{channel}}", "field": "todos" }], "props": { "limit": 30 } }
        ]
      }
    ]
  }
}
