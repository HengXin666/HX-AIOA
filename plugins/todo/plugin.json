{
  "id": "todo",
  "name": "点子待办",
  "summary": "在群里随手丢想法, Agent 定时整理成待办; 可关联 GitHub issue, issue 关闭时待办自动完成。",
  "version": "1.6.1",
  "icon": "list-checks",
  "tags": [
    "待办",
    "点子",
    "Agent"
  ],
  "author": "HengXin666",
  "readme": "README.md",
  "prompt": "prompt.md",
  "group": {
    "title": "点子待办"
  },
  "agent": {
    "name": "整理员",
    "schedule": "每 30 分钟一次, 外加主人说 \"整理一下\" 时立即跑一次",
    "interval": 1800,
    "task": "按专属指令里的插件任务整理这个群的新消息。"
  },
  "space": {
    "id": "todo",
    "title": "点子待办",
    "icon": "list-checks",
    "panels": [
      {
        "id": "todos",
        "title": "待办",
        "icon": "list-checks",
        "size": "l",
        "refresh": {
          "mode": "push"
        },
        "items": [
          {
            "id": "todo-list",
            "type": "todo",
            "bind": [
              {
                "subject": "{{channel}}",
                "field": "todos"
              }
            ],
            "props": {
              "limit": 30
            }
          }
        ]
      }
    ]
  },
  "deps": [
    {
      "id": "gh",
      "optional": true
    }
  ]
}
